{
  "_version": "1.60.0",
  "sap.app": {
    "id": "zov",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.25.0",
      "toolsId": "075c53d9-8dcd-471c-b3e4-a4affeb7684d"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZOV_SRV_01/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.123.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zov.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "zov.view",
        "async": true,
        "viewPath": "zov.view"
      },
      "routes": [
        {
          "name": "RouteOrdemList",
          "pattern": ":?query:",
          "target": [
            "TargetOrdemList"
          ]
        },

        {
          "name": "RouteOrdemNew",
          "pattern": "ordem/new",
          "target": [
            "TargetOrdemForm"
          ]
        },

           {
          "name": "RouteOrdemEdit",
          "pattern": "ordem/{OrdemId}/edit",
          "target": [
            "TargetOrdemForm"
          ]
        }

      ],
      "targets": {
        "TargetOrdemList": {
          "viewType": "XML",
          "transition":"slide",
          "clearControlAggregation": false,
          "id": "OrdemList",
          "name": "OrdemList"
        },

        "TargetOrdemForm":{
          "viewType": "XML",
          "transition":"slide",
          "clearControlAggregation": false,
          "viewId": "OrdemForm",
          "viewName": "OrdemForm"


        }
      }
    },
    "rootView": {
      "viewName": "zov.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
